local GeorgeMusicVehicleReady = false
local GeorgeMusicChanging = false

-- بعد موت اللاعب لازم نعيد تفعيل السكوتر من جديد
LocalPlayer.CharacterAdded:Connect(function()
    GeorgeMusicVehicleReady = false
end)

local function GeorgePlayMusic(musicId)
    local remote = ReplicatedStorage:WaitForChild("RE"):WaitForChild("1NoMoto1rVehicle1s")
    musicId = tostring(musicId)

    if musicId == "" then return end

    -- يمنع ضغط أكثر من أغنية بنفس اللحظة
    if GeorgeMusicChanging then return end
    GeorgeMusicChanging = true

    -- أول أغنية فقط تنشئ السكوتر.
    -- إعادة إرسال SkateBoard مع كل أغنية هو سبب أن التبديل يتعطل حتى الموت.
    if not GeorgeMusicVehicleReady then
        pcall(function()
            remote:FireServer("SkateBoard")
        end)

        -- نعطي السيرفر وقتًا لإنشاء السكوتر قبل إرسال كود الأغنية
        task.wait(0.25)
        GeorgeMusicVehicleReady = true
    end

    -- غيّر الأغنية على نفس السكوتر بدون إعادة إنشائه
    pcall(function()
        remote:FireServer("PickingScooterMusicText", musicId)
    end)

    task.wait(0.08)
    GeorgeMusicChanging = false
end

local function GeorgeAddMusicButton(tab, name, musicId)
    tab:AddButton({
        Name = name,
        Callback = function()
            GeorgePlayMusic(musicId)
        end
    })
end




