--==================================================

SettingsTab:AddSection({
    Name = "Performance"
})

local LowMap = false
local LowMapBackup = {}

local function backup(obj, prop)
    if not LowMapBackup[obj] then
        LowMapBackup[obj] = {}
    end

    if LowMapBackup[obj][prop] == nil then
        local ok, value = pcall(function()
            return obj[prop]
        end)

        if ok then
            LowMapBackup[obj][prop] = value
        end
    end
end

local function change(obj, prop, value)
    backup(obj, prop)

    pcall(function()
        obj[prop] = value
    end)
end

local function optimize(obj)
    if not obj or not obj.Parent then
        return
    end

    -- مؤثرات
    if obj:IsA("ParticleEmitter")
    or obj:IsA("Trail")
    or obj:IsA("Beam")
    or obj:IsA("Smoke")
    or obj:IsA("Fire")
    or obj:IsA("Sparkles") then

        change(obj, "Enabled", false)

    -- الإضاءة
    elseif obj:IsA("PointLight")
    or obj:IsA("SpotLight")
    or obj:IsA("SurfaceLight") then

        change(obj, "Enabled", false)

    -- الصور
    elseif obj:IsA("Decal")
    or obj:IsA("Texture") then

        change(obj, "Transparency", 1)

    -- المجسمات
    elseif obj:IsA("BasePart") then

        change(obj, "Material", Enum.Material.SmoothPlastic)
        change(obj, "CastShadow", false)

        pcall(function()
            change(obj, "Reflectance", 0)
        end)

    -- Post Effects
    elseif obj:IsA("PostEffect") then

        change(obj, "Enabled", false)
    end
end

local function EnableLowMap()

    if LowMap then
        return
    end

    LowMap = true
    LowMapBackup = {}

    local Lighting = game:GetService("Lighting")

    -- أقل جودة رسومية
    pcall(function()
        settings().Rendering.QualityLevel =
            Enum.QualityLevel.Level01
    end)

    -- إيقاف الظلال
    change(Lighting, "GlobalShadows", false)

    -- تقليل إضاءة البيئة
    pcall(function()
        change(Lighting, "EnvironmentDiffuseScale", 0)
        change(Lighting, "EnvironmentSpecularScale", 0)
    end)

    -- تخفيف الماب
    for _, obj in ipairs(workspace:GetDescendants()) do
        optimize(obj)
    end

    -- تخفيف Lighting
    for _, obj in ipairs(Lighting:GetDescendants()) do
        optimize(obj)
    end
end

local function RestoreMap()

    if not LowMap then
        return
    end

    LowMap = false

    for obj, properties in pairs(LowMapBackup) do

        if obj and obj.Parent then

            for property, value in pairs(properties) do

                pcall(function()
                    obj[property] = value
                end)

            end
        end
    end

    LowMapBackup = {}
end

SettingsTab:AddToggle({
    Name = "Extreme Low Map",
    Default = false,

    Callback = function(Value)

        if Value then
            EnableLowMap()
        else
            RestoreMap()
        end

    end
})


