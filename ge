CreateRankTag = function(player)
    if not player or not player.Character then return end

    if HideAllRanks then
        if RankTags[player] then
            pcall(function() RankTags[player]:Destroy() end)
            RankTags[player] = nil
        end
        return
    end

    if player == LocalPlayer and not ShowOwnRankTag then
        if RankTags[player] then
            pcall(function() RankTags[player]:Destroy() end)
            RankTags[player] = nil
        end
        return
    end

    local character = player.Character
    local head = character:FindFirstChild("Head")
    if not head then return end

    if RankTags[player] then
        pcall(function() RankTags[player]:Destroy() end)
        RankTags[player] = nil
    end

    local rankText = GetRankDisplay(player)

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "GeorgeRankTag"
    billboard.Adornee = head
    billboard.Size = UDim2.new(0, 90, 0, 32)
    billboard.StudsOffset = Vector3.new(0, 3.2, 0)
    billboard.AlwaysOnTop = true
    billboard.ResetOnSpawn = false
    billboard.Parent = head

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    frame.BorderSizePixel = 0
    frame.Parent = billboard
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = rankText
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextSize = 17
    label.Font = Enum.Font.GothamBold
    label.Parent = frame

    RankTags[player] = billboard
end

local function HookRankPlayer(player)
    if not player then return end

    player.CharacterAdded:Connect(function()
        task.wait(0.8)
        if player.Parent then
            CreateRankTag(player)
        end
    end)

    if player.Character then
        task.spawn(function()
            CreateRankTag(player)
        end)
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    HookRankPlayer(player)
end

Players.PlayerAdded:Connect(function(player)
