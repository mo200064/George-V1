local function AdminNotify(title, text, duration)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title or "George Hub",
            Text = text or "",
            Duration = duration or 3
        })
    end)
end

local function IsAuthorizedAdmin(player)
    return player and (Owners[player.Name] == true or Admins[player.Name] == true)
end

local function CanAdminTarget(sender, target)
    if not sender or not target then return false end
    if not IsAuthorizedAdmin(sender) then return false end

    -- 🚫 الادمن لا يستطيع تنفيذ أي أمر على Owner.
    -- الـOwner يستطيع استخدام الأوامر على الآخرين.
    if Owners[target.Name] and not Owners[sender.Name] then
        return false
    end

    return true
end

--========================================================
-- 📡 مستقبل أوامر  
--========================================================
-- لا يحتاج RemoteEvent من خارج السكربت.
-- الأمر يُكتب مؤقتًا في RPName للمرسل، واللاعب الذي لديه
-- George Hub فقط هو الذي يقرأه وينفذه.
--========================================================

local function ExecuteGeorgeAdminCommand(sender, action, targetName)
    if not sender or not action or not targetName then return end
    if not IsAuthorizedAdmin(sender) then return end

    action = string.lower(action)
    targetName = string.lower(targetName)

    local meName = string.lower(LocalPlayer.Name)
    local meDisplay = string.lower(LocalPlayer.DisplayName)

    -- الأمر موجه لي أو للجميع.
    if targetName ~= meName and targetName ~= meDisplay and targetName ~= "all" then
        return
    end

    -- 🚫 حماية الـOwner من أي Admin.
    if Owners[LocalPlayer.Name] and not Owners[sender.Name] then
        AdminNotify("🛡️ George Hub", "لا يمكن للـAdmin تنفيذ أوامر على الـOwner.", 3)
        return
    end

    -- لا تسمح للأمر بالتأثير على نفس الـOwner إلا إذا كان المرسل Owner.
    if sender == LocalPlayer and action ~= "unban" then
        return
    end

    if action == "kick" then
        LocalPlayer:Kick("🚫 George Hub: تم طردك بواسطة الإدارة.")

    elseif action == "ban" then
        isBanned = true
        pcall(function()
            if writefile then
                writefile("GeorgeHubBanSave_" .. LocalPlayer.UserId .. ".txt", "BANNED")
            end
        end)
        AdminNotify("🚫 George Hub", "تم تبنيدك بواسطة الإدارة.", 5)

    elseif action == "unban" then
        isBanned = false
        pcall(function()
            if writefile then
                writefile("GeorgeHubBanSave_" .. LocalPlayer.UserId .. ".txt", "UNBANNED")
            end
        end)
        AdminNotify("✅ George Hub", "تم فك الحظر عنك بواسطة الإدارة.", 5)

    elseif action == "freeze" then
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root then
            root.Anchored = true
            AdminNotify("❄️ تجميد", "تم تجميدك بواسطة الإدارة.", 3)
        end

    elseif action == "unfreeze" then
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root then
            root.Anchored = false
            AdminNotify("🔓 فك التجميد", "تم فك تجميدك.", 3)
        end

    elseif action == "kill" then
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.Health = 0
        end

    elseif action == "bring" then
        local senderChar = sender.Character
        local myChar = LocalPlayer.Character
        local senderRoot = senderChar and senderChar:FindFirstChild("HumanoidRootPart")
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if senderRoot and myRoot then
            myRoot.CFrame = senderRoot.CFrame * CFrame.new(0, 0, -3)
        end

    elseif action == "crash" then
        -- تم الإبقاء عليه كأمر محلي فقط؛ لا يتم تنفيذ crash على Owner من Admin.
        AdminNotify("⚠️ George Hub", "تم استلام أمر الإدارة.", 2)
    end
end

local function WatchGeorgeAdminPlayer(player)
    if not player then return end

    task.spawn(function()
        while player and player.Parent == Players do
            local bag = player:FindFirstChild("PlayersBag")
            local rpName = bag and bag:FindFirstChild("RPName")

            if rpName then
                local current = tostring(rpName.Value or "")
                if current ~= "" and current ~= (LastGeorgeAdminCommand[player] or "") and string.sub(string.lower(current), 1, 1) == "!" then
                    local action, targetName = string.match(current, "^!(%w+)%s+(.+)$")
                    if action and targetName then
                        LastGeorgeAdminCommand[player] = current
                        ExecuteGeorgeAdminCommand(player, action, targetName)
                    end
                end
            end

            task.wait(0.35)
        end
    end)
end

