-- ثقب أسود - مضاف إلى خانة السكربتات فقط
MusicTab:AddSection({ "ثقب أسود" })

do
    local BlackHolePlayers = game:GetService("Players")
    local BlackHoleRunService = game:GetService("RunService")
    local BlackHoleLocalPlayer = BlackHolePlayers.LocalPlayer
    local BlackHoleWorkspace = game:GetService("Workspace")

    local BlackHoleAngle = 1
    local BlackHoleRadius = 10
    local BlackHoleActive = false
    local BlackHoleConnection = nil
    local BlackHoleDescendantConnection = nil
    local BlackHoleCharacterConnection = nil
    local BlackHoleHumanoidRootPart = nil
    local BlackHoleAttachment = nil
    local BlackHoleFolder = nil

    local function setupBlackHolePlayer()
        local character = BlackHoleLocalPlayer.Character or BlackHoleLocalPlayer.CharacterAdded:Wait()
        local root = character:WaitForChild("HumanoidRootPart")

        if BlackHoleFolder then
            BlackHoleFolder:Destroy()
        end

        BlackHoleFolder = Instance.new("Folder")
        BlackHoleFolder.Name = "GeorgeHubBlackHole"
        BlackHoleFolder.Parent = BlackHoleWorkspace

        local part = Instance.new("Part")
        part.Anchored = true
        part.CanCollide = false
        part.Transparency = 1
        part.Size = Vector3.new(1, 1, 1)
        part.Parent = BlackHoleFolder

        BlackHoleAttachment = Instance.new("Attachment")
        BlackHoleAttachment.Parent = part
        BlackHoleHumanoidRootPart = root
    end

    local function forceBlackHolePart(v)
        if not v:IsA("Part") or v.Anchored then
            return
        end

        local parent = v.Parent
        if parent and (parent:FindFirstChildOfClass("Humanoid") or parent:FindFirstChild("Head")) then
            return
        end
        if v.Name == "Handle" then
            return
        end

        for _, x in ipairs(v:GetChildren()) do
            if x:IsA("BodyAngularVelocity") or x:IsA("BodyForce") or x:IsA("BodyGyro")
                or x:IsA("BodyPosition") or x:IsA("BodyThrust") or x:IsA("BodyVelocity")
                or x:IsA("RocketPropulsion") then
                x:Destroy()
            end
        end

        for _, childName in ipairs({"Attachment", "AlignPosition", "Torque"}) do
            local child = v:FindFirstChild(childName)
            if child then
                child:Destroy()
            end
        end

        v.CanCollide = false

        local torque = Instance.new("Torque")
        torque.Torque = Vector3.new(1000000, 1000000, 1000000)
        torque.Parent = v

        local attachment2 = Instance.new("Attachment")
        attachment2.Parent = v
        torque.Attachment0 = attachment2

        local alignPosition = Instance.new("AlignPosition")
        alignPosition.MaxForce = math.huge
        alignPosition.MaxVelocity = math.huge
        alignPosition.Responsiveness = 500
        alignPosition.Attachment0 = attachment2
        alignPosition.Attachment1 = BlackHoleAttachment
        alignPosition.Parent = v
    end

    local function stopBlackHole()
        BlackHoleActive = false

        if BlackHoleConnection then
            BlackHoleConnection:Disconnect()
            BlackHoleConnection = nil
        end
        if BlackHoleDescendantConnection then
            BlackHoleDescendantConnection:Disconnect()
            BlackHoleDescendantConnection = nil
        end

        if BlackHoleAttachment then
            BlackHoleAttachment.WorldCFrame = CFrame.new(0, -1000, 0)
        end
    end

    local function startBlackHole()
        if BlackHoleActive then
            return
        end

        if not BlackHoleHumanoidRootPart or not BlackHoleHumanoidRootPart.Parent then
            setupBlackHolePlayer()
        end

        BlackHoleActive = true

        for _, v in ipairs(BlackHoleWorkspace:GetDescendants()) do
            if BlackHoleActive then
                pcall(forceBlackHolePart, v)
            end
        end

        BlackHoleDescendantConnection = BlackHoleWorkspace.DescendantAdded:Connect(function(v)
            if BlackHoleActive then
                task.defer(function()
                    pcall(forceBlackHolePart, v)
                end)
            end
        end)

        BlackHoleConnection = BlackHoleRunService.RenderStepped:Connect(function()
            if not BlackHoleActive then
                return
            end

            if not BlackHoleHumanoidRootPart or not BlackHoleHumanoidRootPart.Parent then
                return
            end

            BlackHoleAngle = BlackHoleAngle + math.rad(2)
            local offsetX = math.cos(BlackHoleAngle) * BlackHoleRadius
            local offsetZ = math.sin(BlackHoleAngle) * BlackHoleRadius
            BlackHoleAttachment.WorldCFrame = BlackHoleHumanoidRootPart.CFrame * CFrame.new(offsetX, 0, offsetZ)
        end)
    end

    setupBlackHolePlayer()

    BlackHoleCharacterConnection = BlackHoleLocalPlayer.CharacterAdded:Connect(function()
        task.wait(0.2)
        setupBlackHolePlayer()
        if BlackHoleActive then
            -- إعادة تشغيل الاتصال بعد تغيير الشخصية
            stopBlackHole()
            startBlackHole()
        end
    end)

    MusicTab:AddButton({
        Name = "ثقب أسود",
        Description = "تفعيل/إيقاف جذب القطع نحو شخصيتك",
        Callback = function()
            if BlackHoleActive then
                stopBlackHole()
            else
                startBlackHole()
            end
        end
    })
end

