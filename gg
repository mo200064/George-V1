-- الكواكب المدارية
local planetsData = {
	{name = "Mercury", dist = 2.0, size = 0.3, color = Color3.fromRGB(160, 160, 160), speed = 2.5},
	{name = "Venus", dist = 2.8, size = 0.45, color = Color3.fromRGB(220, 160, 80), speed = 1.8},
	{name = "Earth", dist = 3.8, size = 0.5, color = Color3.fromRGB(60, 120, 240), speed = 1.2},
	{name = "Mars", dist = 4.8, size = 0.4, color = Color3.fromRGB(220, 80, 50), speed = 0.9},
	{name = "Jupiter", dist = 6.2, size = 0.9, color = Color3.fromRGB(200, 140, 100), speed = 0.5},
}

local orbitParts = {}

for _, pInfo in ipairs(planetsData) do
	-- رسم خط المدار
	local orbitSegments = 60
	for j = 1, orbitSegments do
		local angle = (j / orbitSegments) * math.pi * 2
		local pos = Vector3.new(math.cos(angle) * pInfo.dist, 0, math.sin(angle) * pInfo.dist)
		local dot = Instance.new("Part")
		dot.Size = Vector3.new(0.03, 0.03, 0.03)
		dot.Color = Color3.fromRGB(80, 80, 100)
		dot.Material = Enum.Material.SmoothPlastic
		dot.Anchored = true
		dot.CanCollide = false
		dot.CFrame = CFrame.new(pos)
		dot.Parent = ssModel
	end

	-- مجسم الكوكب
	local planetPart = Instance.new("Part")
	planetPart.Name = pInfo.name
	planetPart.Shape = Enum.PartType.Ball
	planetPart.Size = Vector3.new(pInfo.size, pInfo.size, pInfo.size)
	planetPart.Color = pInfo.color
	planetPart.Material = Enum.Material.SmoothPlastic
	planetPart.Anchored = true
	planetPart.CanCollide = false
	planetPart.Parent = ssModel

	table.insert(orbitParts, {part = planetPart, dist = pInfo.dist, speed = pInfo.speed, angle = math.random() * math.pi * 2})
end

