local function generateUltraSmoothEarth()
	local radius = 1.91
	local continentData = {
		{lat = math.rad(48), long = math.rad(-100), rLat = 0.55, rLong = 0.85},
		{lat = math.rad(65), long = math.rad(-45), rLat = 0.35, rLong = 0.45},
		{lat = math.rad(28), long = math.rad(-95), rLat = 0.25, rLong = 0.35},
		{lat = math.rad(-12), long = math.rad(-60), rLat = 0.55, rLong = 0.45},
		{lat = math.rad(-32), long = math.rad(-65), rLat = 0.40, rLong = 0.25},
		{lat = math.rad(12), long = math.rad(18), rLat = 0.50, rLong = 0.60},
		{lat = math.rad(-20), long = math.rad(25), rLat = 0.45, rLong = 0.35},
		{lat = math.rad(55), long = math.rad(45), rLat = 0.55, rLong = 1.10},
		{lat = math.rad(40), long = math.rad(95), rLat = 0.60, rLong = 1.20},
		{lat = math.rad(65), long = math.rad(15), rLat = 0.35, rLong = 0.30},
		{lat = math.rad(-25), long = math.rad(135), rLat = 0.35, rLong = 0.40},
	}

	local totalPoints = 2500
	for i = 1, totalPoints do
		local phi = math.acos(1 - 2 * (i / totalPoints))
		local theta = math.pi * (1 + math.sqrt(5)) * i

		local dir = Vector3.new(
			math.sin(phi) * math.cos(theta),
			math.cos(phi),
			math.sin(phi) * math.sin(theta)
		).Unit

		local lat = math.asin(dir.Y)
		local long = math.atan2(dir.Z, dir.X)

		local isLand = false
		for _, c in ipairs(continentData) do
			local dLat = lat - c.lat
			local dLong = long - c.long

			if dLong > math.pi then dLong = dLong - 2 * math.pi end
			if dLong < -math.pi then dLong = dLong + 2 * math.pi end

			local normalizedDist = (dLat / c.rLat)^2 + (dLong / c.rLong)^2
			if normalizedDist <= 1.0 then
				isLand = true
				break
			end
		end

		if isLand then
			local landPart = Instance.new("Part")
			landPart.Size = Vector3.new(0.12, 0.12, 0.01)
			landPart.Color = Color3.fromRGB(255, 255, 255)
			landPart.Material = Enum.Material.SmoothPlastic
			landPart.Anchored = true
			landPart.CanCollide = false
			landPart.CFrame = CFrame.lookAt(dir * radius, dir * (radius + 1))
			landPart.Parent = planetModel
		end
	end
end

generateUltraSmoothEarth()

local function createPlanetaryRings()
	local ringRadiusOuter = 3.2
	local ringRadiusInner = 2.4
	local ringSegments = 120

	for i = 1, ringSegments do
		local angle = (i / ringSegments) * math.pi * 2
		local posInner = Vector3.new(math.cos(angle) * ringRadiusInner, 0, math.sin(angle) * ringRadiusInner)
		local posOuter = Vector3.new(math.cos(angle) * ringRadiusOuter, 0, math.sin(angle) * ringRadiusOuter)

		local ringPart = Instance.new("Part")
		ringPart.Size = Vector3.new(0.02, 0.02, 0.08)
		ringPart.Color = (i % 2 == 0) and Color3.fromRGB(240, 240, 240) or Color3.fromRGB(120, 120, 120)
		ringPart.Material = Enum.Material.SmoothPlastic
		ringPart.Anchored = true
		ringPart.CanCollide = false
		ringPart.CFrame = CFrame.lookAt(posOuter, posOuter * 2)
		ringPart.Parent = planetModel

		if i % 3 == 0 then
			local accentPart = Instance.new("Part")
			accentPart.Size = Vector3.new(0.02, 0.02, 0.05)
			accentPart.Color = Color3.fromRGB(200, 200, 200)
			accentPart.Material = Enum.Material.SmoothPlastic
			accentPart.Anchored = true
			accentPart.CanCollide = false
			accentPart.CFrame = CFrame.lookAt(posInner, posInner * 2)
			accentPart.Parent = planetModel
		end
	end
end

createPlanetaryRings()

