-- 9. GUI WINDOW DRAGGING LOGIC
--------------------------------------------------------------------------------
local guiDragging = false
local guiDragStart = nil
local guiStartPos = nil

topBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		guiDragging = true
		guiDragStart = input.Position
		guiStartPos = mainFrame.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				guiDragging = false
			end
		end)
	end
end)

topBar.InputChanged:Connect(function(input)
	if guiDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - guiDragStart
		mainFrame.Position = UDim2.new(
			guiStartPos.X.Scale,
			guiStartPos.X.Offset + delta.X,
			guiStartPos.Y.Scale,
			guiStartPos.Y.Offset + delta.Y
		)
	end
end)

--------------------------------------------------------------------------------
-- 10. ROTATION & ORBIT ANIMATION LOGIC
--------------------------------------------------------------------------------
local isRotatingPlanet = false
local lastInputPosition = nil

local currentYaw = math.rad(-100)
local currentPitch = math.rad(15)

local targetYaw = math.rad(-100)
local targetPitch = math.rad(15)

RunService.RenderStepped:Connect(function(deltaTime)
	if planetPage.Visible then
		currentYaw = currentYaw + (targetYaw - currentYaw) * 0.15
		currentPitch = currentPitch + (targetPitch - currentPitch) * 0.15

		if not isRotatingPlanet then
			targetYaw = targetYaw + (0.2 * deltaTime)
		end

		local rotCFrame = CFrame.Angles(0, currentYaw, 0) * CFrame.Angles(currentPitch, 0, 0)
		planetModel:PivotTo(CFrame.new(0, 0, 0) * rotCFrame)
	elseif solarSystemPage.Visible then
		-- تحريك الكواكب في مداراتها حول الشمس
		for _, orb in ipairs(orbitParts) do
			orb.angle = orb.angle + (orb.speed * deltaTime)
			local posX = math.cos(orb.angle) * orb.dist
			local posZ = math.sin(orb.angle) * orb.dist
			orb.part.CFrame = CFrame.new(posX, 0, posZ)
		end
	end
end)
