local function switchTab(tabName)
	creditsPage.Visible = (tabName == "Credits")
	planetPage.Visible = (tabName == "Planet")
	solarSystemPage.Visible = (tabName == "SolarSystem")

	creditsTabBtn.BackgroundColor3 = (tabName == "Credits") and Color3.fromRGB(50, 50, 50) or Color3.fromRGB(30, 30, 30)
	creditsTabBtn.TextColor3 = (tabName == "Credits") and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 180)

	planetTabBtn.BackgroundColor3 = (tabName == "Planet") and Color3.fromRGB(50, 50, 50) or Color3.fromRGB(30, 30, 30)
	planetTabBtn.TextColor3 = (tabName == "Planet") and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 180)

	solarSystemTabBtn.BackgroundColor3 = (tabName == "SolarSystem") and Color3.fromRGB(50, 50, 50) or Color3.fromRGB(30, 30, 30)
	solarSystemTabBtn.TextColor3 = (tabName == "SolarSystem") and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 180)

	if tabName == "Planet" or tabName == "SolarSystem" then
		if not bgmSound.IsPlaying then bgmSound:Play() end
	else
		if bgmSound.IsPlaying then bgmSound:Stop() end
	end
end

