local function InitPlayerTracking(player)
    if not PlayerActivity[player.UserId] then
        PlayerActivity[player.UserId] = { Joins = 1, Leaves = 0 }
    else
        PlayerActivity[player.UserId].Joins = PlayerActivity[player.UserId].Joins + 1
    end
end

