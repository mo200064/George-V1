    local function createBangToggle(name, yOffset, faceBang)
        local toggleActive = false
        local connectionKey = name

        AddOnOffBtn(Content, name, false, function(Value)
            toggleActive = Value

            if Value then EnableAntiSit() else DisableAntiSit() end

            if bangConnections[connectionKey] then
