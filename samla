        _G.FollowAnimConnection = RS.Heartbeat:Connect(function(dt)
            local myChar = LP.Character
            if not TargetPlayer or not TargetPlayer.Character or not myChar then return end
            local myHRP = myChar:FindFirstChild("HumanoidRootPart")
            local targetHRP = TargetPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not myHRP or not targetHRP then return end
            t = t + dt * 6
            local minDist = 0.9 local maxDist = 1.5 local alpha = (math.sin(t) + 1) / 2
            local distance = minDist + (maxDist - minDist) * alpha
            local frontPos = targetHRP.CFrame * CFrame.new(0, 0, -distance)
            myHRP.CFrame = CFrame.new(frontPos.Position, targetHRP.Position) * CFrame.Angles(0, math.rad(180), 0)
            myHRP.Velocity = Vector3.zero
        end)
